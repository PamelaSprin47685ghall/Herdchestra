{:source-paths ["src"]
 ;; shadow-cljs lives in :shadow (no :main-opts); browser runtime deps in
 ;; :client.  Keep :cljs out of this list so its `-m cljs.main` cannot
 ;; override the shadow CLI.
 ;; shadow ignores :source-paths when :deps is used; `:browser-test` puts the
 ;; `test` classpath in deps.edn for the focused browser harness.  The
 ;; production :app build only compiles the namespaces its entry requires.
 :deps {:aliases [:shadow :client :browser-test]}
 ;; The npm launcher starts its own JVM and does not necessarily inherit the
 ;; deps.edn alias options.  Cap the compiler heap explicitly; this build is
 ;; small and one gigabyte is enough.
 :jvm-opts ["-Xmx1g" "-XX:MaxDirectMemorySize=512m"]
 :builds
 {:app
  {:target :browser
   :output-dir "resources/public/js"
   :asset-path "/js"
   :modules {:main {:init-fn hc.client.workbench.main/init}}
   :devtools {:after-load hc.client.workbench.main/after-load
              :preloads []}
   :compiler-options {:infer-externs :auto}}

  ;; Focused real-browser consumer harness for the conversation surface.
  ;; It mounts only the surface (no Sente/server) so the selection contract
  ;; can be driven deterministically by test/js/verify_conversation_selection_browser.sh.
  :conversation-selection-test
  {:target :browser
   :output-dir "target/conversation-selection-test/js"
   :asset-path "/js"
   :modules {:main {:init-fn hc.client.conversation.selection-browser-test/init}}
   :compiler-options {:infer-externs :auto}}}}
