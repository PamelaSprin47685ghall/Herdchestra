{
  "name": "herdchestra-client",
  "version": "0.0.2",
  "private": true,
  "type": "module",
  "description": "Browser client dependencies for the Herdchestra thin workbench.",
  "dependencies": {
    "@cljs-oss/module-deps": "^1.1.1",
    "framework7": "^9.3.0",
    "framework7-react": "^9.3.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "jsdom": "26.1.0",
    "shadow-cljs": "3.5.11"
  },
  "scripts": {
    "build:css": "mkdir -p resources/public/css && cp node_modules/framework7/framework7-bundle.css resources/public/css/framework7-bundle.css",
    "dev": "npm run build:css && npx shadow-cljs watch :app",
    "release": "npm run build:css && npx shadow-cljs release :app",
    "e2e": "playwright test --config test/e2e/playwright.config.mjs",
    "e2e:core": "playwright test --config test/e2e/playwright.config.mjs --grep @core",
    "e2e:mock": "playwright test --config test/e2e/playwright.config.mjs --grep @mock",
    "e2e:memory": "playwright test --config test/e2e/playwright.config.mjs --grep @memory"
  }
}
