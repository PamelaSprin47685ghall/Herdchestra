{
  "name": "herdchestra",
  "version": "1.0.0",
  "description": "Orchestration for agents that don't like being orchestrated. Tool and message-projection layer for OpenCode v2, Cline Desktop and Oh My Pi.",
  "type": "module",
  "license": "SEE LICENSE IN LICENSE",
  "engines": {
    "node": ">=22"
  },
  "files": [
    "src",
    "LICENSE",
    "!src/**/*.test.mjs",
    "!src/**/AGENTS.md",
    "!src/**/live/**",
    "!src/compose/HOST-PORTS.md"
  ],
  "exports": {
    "./package.json": "./package.json",
    "./host-omp": "./src/host-omp/index.mjs",
    "./host-opencode": "./src/host-opencode/index.js",
    "./host-cline": "./src/host-cline/index.js"
  },
  "workspaces": [
    "src/host-omp",
    "src/host-opencode",
    "src/host-cline"
  ],
  "scripts": {
    "test": "node --test \"src/**/*.test.mjs\"",
    "test:core": "node --test \"src/core/**/*.test.mjs\"",
    "test:compose": "node --test \"src/compose/**/*.test.mjs\"",
    "test:host-cline": "node --test \"src/host-cline/**/*.test.mjs\"",
    "test:host-opencode": "node --test \"src/host-opencode/**/*.test.mjs\"",
    "test:host-omp": "node --test \"src/host-omp/**/*.test.mjs\"",
    "test:quick": "HC_FC_RUNS=20 node --test --test-concurrency=$(nproc) \"src/**/*.test.mjs\"",
    "smoke": "node scripts/smoke/all.mjs",
    "smoke:omp": "node scripts/smoke/omp.mjs",
    "smoke:opencode": "node scripts/smoke/opencode.mjs",
    "smoke:cline": "node scripts/smoke/cline.mjs"
  },
  "dependencies": {
    "effect": "4.0.1"
  },
  "devDependencies": {
    "fast-check": "^4.3.0"
  },
  "keywords": [
    "orchestration",
    "agents",
    "opencode",
    "cline",
    "oh-my-pi"
  ],
  "cline": {
    "plugins": [
      {
        "paths": [
          "./src/host-cline/index.js"
        ],
        "capabilities": [
          "tools",
          "hooks",
          "rules"
        ]
      }
    ]
  }
}
